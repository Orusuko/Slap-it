{
  "name": "slay-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @slay-it/shared",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @slay-it/web",
    "dev:server": "npm run dev -w @slay-it/server",
    "build": "npm run build -w @slay-it/shared && npm run build -w @slay-it/web && npm run build -w @slay-it/server",
    "build:web": "npm run build -w @slay-it/shared && npm run build -w @slay-it/web",
    "pretest": "npm run build -w @slay-it/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
